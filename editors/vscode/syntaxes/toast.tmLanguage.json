{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Toast",
  "scopeName": "source.toast",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#symbols" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.toast",
          "match": "//.*$"
        },
        {
          "name": "comment.block.toast",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.toast",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.toast",
              "match": "\\\\."
            },
            {
              "name": "meta.interpolation.toast",
              "begin": "(?<!\\\\)\\{",
              "beginCaptures": {
                "0": { "name": "punctuation.section.interpolation.begin.toast" }
              },
              "end": "\\}",
              "endCaptures": {
                "0": { "name": "punctuation.section.interpolation.end.toast" }
              },
              "patterns": [{ "include": "$self" }]
            }
          ]
        },
        {
          "name": "string.quoted.single.toast",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.toast",
              "match": "\\\\."
            },
            {
              "name": "meta.interpolation.toast",
              "begin": "(?<!\\\\)\\{",
              "beginCaptures": {
                "0": { "name": "punctuation.section.interpolation.begin.toast" }
              },
              "end": "\\}",
              "endCaptures": {
                "0": { "name": "punctuation.section.interpolation.end.toast" }
              },
              "patterns": [{ "include": "$self" }]
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.toast",
          "match": "\\b(?:\\d+\\.\\d+|\\.\\d+)\\b"
        },
        {
          "name": "constant.numeric.integer.toast",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "symbols": {
      "patterns": [
        {
          "name": "keyword.operator.toast",
          "match": "[!@#$%^&*\\-=+\\.?/<>|:~`]+"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.readwrite.toast",
          "match": "[\\p{L}_][\\p{L}\\p{Nd}_]*"
        }
      ]
    }
  }
}
