// Toast Language Demo Script

// 1. Imports
import "system"
import "math"
import "datetime"

// Math direct & prefixed calls
var root = sqrt(256)
print("sqrt(256) = " + root)

// Datetime module calls
var now = datetime.now()
print("Current Year: " + now.year)

// 2. Custom types and objects
var Person = type (name, age) => {
    var isAdult = age >= 18
}
var p1 = Person("Alice", 22)
print(p1.name + " is adult: " + p1.isAdult)
